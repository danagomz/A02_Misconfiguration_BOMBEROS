# Copiar como .env para desarrollo local por HTTP.
DEBUG=True
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_LOCAL
DB_NAME=bomberos_cali
DB_USER=app_bomberos
DB_PASSWORD=REEMPLAZAR_POR_LA_CLAVE_PRIVADA
DB_HOST=localhost
DB_PORT=5432
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
ADMIN_PATH=gestion-interna/

# En un despliegue HTTPS real: DEBUG=False, configurar ALLOWED_HOSTS,
# activar SECURE_SSL_REDIRECT y ambas cookies Secure, y usar HSTS_SECONDS=31536000.
